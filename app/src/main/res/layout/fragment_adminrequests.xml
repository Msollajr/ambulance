<?xml version="1.0" encoding="utf-8"?>
<LinearLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="#F7F8FA">

    <!-- Header -->
    <LinearLayout android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="#FFFFFF" android:elevation="4dp"
        android:padding="16dp" android:orientation="vertical">

        <TextView android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Active Requests"
            android:textSize="20sp" android:textStyle="bold"
            android:textColor="#1A1A2E" />

        <TextView android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="All requests assigned to your drivers"
            android:textSize="12sp" android:textColor="#888888"
            android:layout_marginTop="2dp" />
    </LinearLayout>

    <!-- Hospital coords button -->
    <com.google.android.material.button.MaterialButton
        android:id="@+id/btn_set_hospital"
        style="@style/Widget.MaterialComponents.Button.OutlinedButton"
        android:layout_width="match_parent"
        android:layout_height="44dp"
        android:layout_marginStart="16dp"
        android:layout_marginEnd="16dp"
        android:layout_marginTop="10dp"
        android:layout_marginBottom="4dp"
        android:text="🏥  Set / Update Hospital Location"
        android:textSize="13sp"
        android:textColor="#3B608C"
        app:strokeColor="#3B608C"
        app:strokeWidth="1.5dp"
        app:cornerRadius="10dp" />

    <!-- Empty state -->
    <LinearLayout android:id="@+id/empty_state_requests"
        android:layout_width="match_parent"
        android:layout_height="0dp" android:layout_weight="1"
        android:orientation="vertical" android:gravity="center"
        android:visibility="gone">

        <TextView android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="📋" android:textSize="48sp" />
        <TextView android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="No requests yet"
            android:textSize="18sp" android:textStyle="bold"
            android:textColor="#1A1A2E" android:layout_marginTop="10dp" />
        <TextView android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Requests sent to your drivers will appear here"
            android:textSize="13sp" android:textColor="#888888"
            android:gravity="center" android:layout_marginTop="6dp"
            android:paddingStart="32dp" android:paddingEnd="32dp" />
    </LinearLayout>

    <!-- Requests list -->
    <androidx.recyclerview.widget.RecyclerView
        android:id="@+id/rv_admin_requests"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:paddingTop="8dp"
        android:paddingBottom="16dp"
        android:clipToPadding="false" />

</LinearLayout>