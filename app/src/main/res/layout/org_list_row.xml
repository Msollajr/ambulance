<?xml version="1.0" encoding="utf-8"?>
<androidx.cardview.widget.CardView
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginStart="8dp"
    android:layout_marginEnd="8dp"
    android:layout_marginTop="6dp"
    android:layout_marginBottom="4dp"
    app:cardCornerRadius="14dp"
    app:cardElevation="2dp"
    app:cardBackgroundColor="#FFFFFF">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:padding="14dp">

        <!-- Org logo -->
        <ImageView
            android:id="@+id/iv_org_photo"
            android:layout_width="52dp"
            android:layout_height="52dp"
            android:scaleType="centerCrop"
            android:src="@drawable/ic_person_add"
            android:background="@drawable/avatar_circle_bg" />

        <!-- Name + ambulance count -->
        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:layout_marginStart="12dp"
            android:orientation="vertical">

            <TextView
                android:id="@+id/tv_org_name"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Organization Name"
                android:textSize="16sp"
                android:textStyle="bold"
                android:textColor="#1A1A2E" />

            <TextView
                android:id="@+id/tv_org_amb_count"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="3 ambulances available"
                android:textSize="12sp"
                android:textColor="#27AE60"
                android:layout_marginTop="3dp" />
        </LinearLayout>

        <!-- Select button -->
        <com.google.android.material.button.MaterialButton
            android:id="@+id/btn_select_org"
            android:layout_width="wrap_content"
            android:layout_height="40dp"
            android:text="Select"
            android:textSize="13sp"
            android:textColor="#FFFFFF"
            app:backgroundTint="#EA6D35"
            app:cornerRadius="10dp" />

    </LinearLayout>
</androidx.cardview.widget.CardView>
