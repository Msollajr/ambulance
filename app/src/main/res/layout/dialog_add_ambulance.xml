<?xml version="1.0" encoding="utf-8"?>
<ScrollView
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="20dp">

        <!-- Plate number -->
        <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
            android:text="Plate number *" android:textSize="13sp" android:textStyle="bold"
            android:textColor="#1A1A2E" android:layout_marginBottom="6dp" />
        <EditText
            android:id="@+id/et_plate"
            android:layout_width="match_parent"
            android:layout_height="50dp"
            android:background="@drawable/edittext_background"
            android:hint="e.g. T 123 ABC"
            android:textColorHint="#AAAAAA"
            android:textColor="#1A1A2E"
            android:textSize="15sp"
            android:padding="12dp"
            android:inputType="textCapCharacters"
            android:layout_marginBottom="14dp" />

        <!-- Ambulance type -->
        <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
            android:text="Ambulance type" android:textSize="13sp" android:textStyle="bold"
            android:textColor="#1A1A2E" android:layout_marginBottom="6dp" />
        <Spinner
            android:id="@+id/sp_amb_type"
            android:layout_width="match_parent"
            android:layout_height="50dp"
            android:background="@drawable/edittext_background"
            android:padding="8dp"
            android:layout_marginBottom="4dp" />
        <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
            android:orientation="horizontal" android:layout_marginBottom="14dp">
            <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
                android:text="BLS = Basic Life Support  ·  ALS = Advanced  ·  ICU = Intensive Care"
                android:textSize="11sp" android:textColor="#888888" />
        </LinearLayout>

        <!-- Equipment level -->
        <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
            android:text="Equipment level" android:textSize="13sp" android:textStyle="bold"
            android:textColor="#1A1A2E" android:layout_marginBottom="6dp" />
        <Spinner
            android:id="@+id/sp_equip_level"
            android:layout_width="match_parent"
            android:layout_height="50dp"
            android:background="@drawable/edittext_background"
            android:padding="8dp"
            android:layout_marginBottom="4dp" />
        <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
            android:orientation="horizontal" android:layout_marginBottom="14dp">
            <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
                android:text="basic = first aid kit only  ·  full = full medical equipment"
                android:textSize="11sp" android:textColor="#888888" />
        </LinearLayout>

        <!-- Equipment notes -->
        <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
            android:text="Equipment notes (optional)" android:textSize="13sp" android:textStyle="bold"
            android:textColor="#1A1A2E" android:layout_marginBottom="6dp" />
        <EditText
            android:id="@+id/et_equip_notes"
            android:layout_width="match_parent"
            android:layout_height="80dp"
            android:background="@drawable/edittext_background"
            android:hint="e.g. Defibrillator, IV drip, oxygen tank, stretcher…"
            android:textColorHint="#AAAAAA"
            android:textColor="#1A1A2E"
            android:textSize="14sp"
            android:padding="12dp"
            android:gravity="top|start"
            android:inputType="textMultiLine"
            android:layout_marginBottom="14dp" />

        <!-- Cost per trip -->
        <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
            android:text="Cost per trip (TZS)" android:textSize="13sp" android:textStyle="bold"
            android:textColor="#1A1A2E" android:layout_marginBottom="6dp" />
        <EditText
            android:id="@+id/et_cost"
            android:layout_width="match_parent"
            android:layout_height="50dp"
            android:background="@drawable/edittext_background"
            android:hint="0 for free"
            android:textColorHint="#AAAAAA"
            android:textColor="#1A1A2E"
            android:textSize="15sp"
            android:padding="12dp"
            android:inputType="numberDecimal"
            android:layout_marginBottom="14dp" />

        <!-- Status -->
        <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
            android:text="Current status" android:textSize="13sp" android:textStyle="bold"
            android:textColor="#1A1A2E" android:layout_marginBottom="6dp" />
        <Spinner
            android:id="@+id/sp_status"
            android:layout_width="match_parent"
            android:layout_height="50dp"
            android:background="@drawable/edittext_background"
            android:padding="8dp"
            android:layout_marginBottom="6dp" />

    </LinearLayout>
</ScrollView>
