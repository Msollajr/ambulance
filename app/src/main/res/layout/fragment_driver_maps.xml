<?xml version="1.0" encoding="utf-8"?>
<FrameLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent">

    <!-- Full-screen map -->
    <fragment
        android:id="@+id/map"
        android:name="com.google.android.gms.maps.SupportMapFragment"
        android:layout_width="match_parent"
        android:layout_height="match_parent" />

    <!-- TOP: Online status badge -->
    <LinearLayout
        android:id="@+id/online_badge"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="top|end"
        android:layout_margin="12dp"
        android:background="@drawable/online_badge_bg"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:paddingStart="12dp"
        android:paddingEnd="12dp"
        android:paddingTop="6dp"
        android:paddingBottom="6dp"
        android:elevation="6dp">

        <View android:layout_width="8dp" android:layout_height="8dp"
            android:layout_marginEnd="6dp"
            android:background="@drawable/dot_done" />

        <TextView
            android:id="@+id/tv_online_status"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Online"
            android:textSize="12sp"
            android:textStyle="bold"
            android:textColor="#1A1A2E" />
    </LinearLayout>

    <!-- BOTTOM: stacked panels -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_gravity="bottom"
        android:orientation="vertical">

        <!-- INCOMING REQUEST card -->
        <ScrollView
            android:id="@+id/incoming_request_panel"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="#FFFFFF"
            android:elevation="12dp"
            android:visibility="gone"
            android:fillViewport="true">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:paddingStart="16dp"
                android:paddingEnd="16dp"
                android:paddingTop="16dp"
                android:paddingBottom="16dp">

                <!-- Alert header -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:gravity="center_vertical"
                    android:layout_marginBottom="12dp">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="🆘"
                        android:textSize="22sp"
                        android:layout_marginEnd="8dp" />

                    <TextView
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:text="New Emergency Request"
                        android:textSize="16sp"
                        android:textStyle="bold"
                        android:textColor="#1A1A2E" />

                    <TextView
                        android:id="@+id/tv_req_severity"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="HIGH"
                        android:textSize="11sp"
                        android:textStyle="bold"
                        android:textColor="#FFFFFF"
                        android:background="@drawable/badge_navy"
                        android:paddingStart="10dp"
                        android:paddingEnd="10dp"
                        android:paddingTop="4dp"
                        android:paddingBottom="4dp" />
                </LinearLayout>

                <!-- Info grid -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:background="#F7F8FA"
                    android:padding="12dp"
                    android:layout_marginBottom="12dp">

                    <LinearLayout android:layout_width="0dp" android:layout_height="wrap_content"
                        android:layout_weight="1" android:orientation="vertical">
                        <TextView android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="TYPE" android:textSize="10sp"
                            android:textColor="#888" android:textStyle="bold" />
                        <TextView android:id="@+id/tv_req_type"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="—" android:textSize="14sp"
                            android:textStyle="bold" android:textColor="#3B608C"
                            android:layout_marginTop="2dp" />
                    </LinearLayout>

                    <View android:layout_width="1dp" android:layout_height="match_parent"
                        android:background="#DDDDDD"
                        android:layout_marginStart="8dp" android:layout_marginEnd="8dp" />

                    <LinearLayout android:layout_width="0dp" android:layout_height="wrap_content"
                        android:layout_weight="1" android:orientation="vertical">
                        <TextView android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="DISTANCE" android:textSize="10sp"
                            android:textColor="#888" android:textStyle="bold" />
                        <TextView android:id="@+id/tv_req_distance"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="—" android:textSize="14sp"
                            android:textStyle="bold" android:textColor="#1A1A2E"
                            android:layout_marginTop="2dp" />
                    </LinearLayout>

                    <View android:layout_width="1dp" android:layout_height="match_parent"
                        android:background="#DDDDDD"
                        android:layout_marginStart="8dp" android:layout_marginEnd="8dp" />

                    <LinearLayout android:layout_width="0dp" android:layout_height="wrap_content"
                        android:layout_weight="1" android:orientation="vertical">
                        <TextView android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="ETA" android:textSize="10sp"
                            android:textColor="#888" android:textStyle="bold" />
                        <TextView android:id="@+id/tv_req_eta"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="—" android:textSize="14sp"
                            android:textStyle="bold" android:textColor="#1A1A2E"
                            android:layout_marginTop="2dp" />
                    </LinearLayout>
                </LinearLayout>

                <!-- Description -->
                <TextView
                    android:id="@+id/tv_req_description"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text=""
                    android:textSize="13sp"
                    android:textColor="#555555"
                    android:lineSpacingExtra="2dp"
                    android:layout_marginBottom="10dp"
                    android:visibility="gone" />

                <!-- PATCH: Patient photo -->
                <ImageView
                    android:id="@+id/iv_req_photo"
                    android:layout_width="match_parent"
                    android:layout_height="160dp"
                    android:scaleType="centerCrop"
                    android:background="#F7F8FA"
                    android:layout_marginBottom="8dp"
                    android:visibility="gone" />

                <!-- Insurance info — shown if patient has insurance -->
                <TextView
                    android:id="@+id/tv_req_insurance_driver"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:textSize="12sp"
                    android:textColor="#3B608C"
                    android:background="#EEF4FF"
                    android:padding="8dp"
                    android:layout_marginBottom="10dp"
                    android:visibility="gone" />

                <!-- Accept / Reject -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal">

                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/btn_reject"
                        style="@style/Widget.MaterialComponents.Button.OutlinedButton"
                        android:layout_width="0dp"
                        android:layout_height="50dp"
                        android:layout_weight="1"
                        android:layout_marginEnd="8dp"
                        android:text="Reject"
                        android:textSize="15sp"
                        android:textColor="#E74C3C"
                        app:strokeColor="#E74C3C"
                        app:strokeWidth="1.5dp"
                        app:cornerRadius="12dp" />

                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/btn_accept"
                        android:layout_width="0dp"
                        android:layout_height="50dp"
                        android:layout_weight="1"
                        android:layout_marginStart="8dp"
                        android:text="Accept"
                        android:textSize="15sp"
                        android:textStyle="bold"
                        android:textColor="#FFFFFF"
                        app:backgroundTint="#27AE60"
                        app:cornerRadius="12dp" />
                </LinearLayout>
            </LinearLayout>
        </ScrollView>

        <!-- ACTIVE TRIP card -->
        <LinearLayout
            android:id="@+id/active_trip_panel"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:background="#FFFFFF"
            android:elevation="12dp"
            android:paddingStart="16dp"
            android:paddingEnd="16dp"
            android:paddingTop="14dp"
            android:paddingBottom="14dp"
            android:visibility="gone">

            <!-- Trip header -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical"
                android:layout_marginBottom="12dp">

                <LinearLayout
                    android:layout_width="44dp"
                    android:layout_height="44dp"
                    android:background="@drawable/driver_avatar_bg"
                    android:gravity="center">
                    <TextView android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="🆘" android:textSize="20sp" />
                </LinearLayout>

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:layout_marginStart="12dp"
                    android:orientation="vertical">
                    <TextView android:id="@+id/tv_trip_title"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="En Route to Patient"
                        android:textSize="15sp"
                        android:textStyle="bold"
                        android:textColor="#1A1A2E" />
                    <TextView android:id="@+id/tv_trip_subtitle"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Follow the route on the map"
                        android:textSize="12sp"
                        android:textColor="#888888"
                        android:layout_marginTop="2dp" />
                </LinearLayout>

                <TextView android:id="@+id/tv_trip_type_badge"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="BLS"
                    android:textSize="11sp"
                    android:textStyle="bold"
                    android:textColor="#FFFFFF"
                    android:background="@drawable/badge_navy"
                    android:paddingStart="10dp"
                    android:paddingEnd="10dp"
                    android:paddingTop="4dp"
                    android:paddingBottom="4dp" />
            </LinearLayout>

            <!-- Distance + Severity + Patient -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:background="#F7F8FA"
                android:padding="10dp"
                android:layout_marginBottom="12dp">

                <LinearLayout android:layout_width="0dp" android:layout_height="wrap_content"
                    android:layout_weight="1" android:orientation="vertical" android:gravity="center">
                    <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
                        android:text="DISTANCE" android:textSize="10sp"
                        android:textColor="#888" android:textStyle="bold" />
                    <TextView android:id="@+id/tv_trip_distance"
                        android:layout_width="wrap_content" android:layout_height="wrap_content"
                        android:text="— km" android:textSize="14sp"
                        android:textStyle="bold" android:textColor="#1A1A2E"
                        android:layout_marginTop="2dp" />
                </LinearLayout>

                <View android:layout_width="1dp" android:layout_height="match_parent"
                    android:background="#DDDDDD" />

                <LinearLayout android:layout_width="0dp" android:layout_height="wrap_content"
                    android:layout_weight="1" android:orientation="vertical" android:gravity="center">
                    <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
                        android:text="SEVERITY" android:textSize="10sp"
                        android:textColor="#888" android:textStyle="bold" />
                    <TextView android:id="@+id/tv_trip_severity"
                        android:layout_width="wrap_content" android:layout_height="wrap_content"
                        android:text="—" android:textSize="14sp"
                        android:textStyle="bold" android:textColor="#E74C3C"
                        android:layout_marginTop="2dp" />
                </LinearLayout>

                <View android:layout_width="1dp" android:layout_height="match_parent"
                    android:background="#DDDDDD" />

                <LinearLayout android:layout_width="0dp" android:layout_height="wrap_content"
                    android:layout_weight="1" android:orientation="vertical" android:gravity="center">
                    <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
                        android:text="PATIENT" android:textSize="10sp"
                        android:textColor="#888" android:textStyle="bold" />
                    <TextView android:id="@+id/tv_trip_patient_phone"
                        android:layout_width="wrap_content" android:layout_height="wrap_content"
                        android:text="—" android:textSize="11sp"
                        android:textStyle="bold" android:textColor="#1A1A2E"
                        android:layout_marginTop="2dp" />
                </LinearLayout>
            </LinearLayout>

            <!-- Trip action buttons — showTripButtons() controls which are visible -->
            <!-- Phase 1: ON THE WAY — heading to patient -->
            <com.google.android.material.button.MaterialButton
                android:id="@+id/btn_on_the_way"
                android:layout_width="match_parent"
                android:layout_height="52dp"
                android:layout_marginTop="8dp"
                android:text="🚑  ON THE WAY"
                android:textSize="14sp"
                android:textStyle="bold"
                android:textColor="#FFFFFF"
                app:backgroundTint="#3B608C"
                app:cornerRadius="12dp"
                android:visibility="gone" />

            <!-- Phase 2: ARRIVED AT PATIENT — driver physically at patient -->
            <com.google.android.material.button.MaterialButton
                android:id="@+id/btn_arrived"
                android:layout_width="match_parent"
                android:layout_height="52dp"
                android:layout_marginTop="8dp"
                android:text="✅  ARRIVED AT PATIENT"
                android:textSize="14sp"
                android:textStyle="bold"
                android:textColor="#FFFFFF"
                app:backgroundTint="#27AE60"
                app:cornerRadius="12dp"
                android:visibility="gone" />

            <!-- Phase 3a: GOING TO HOSPITAL — take patient to hospital -->
            <com.google.android.material.button.MaterialButton
                android:id="@+id/btn_going_hospital"
                android:layout_width="match_parent"
                android:layout_height="52dp"
                android:layout_marginTop="8dp"
                android:text="🏥  GOING TO HOSPITAL"
                android:textSize="14sp"
                android:textStyle="bold"
                android:textColor="#FFFFFF"
                app:backgroundTint="#EA6D35"
                app:cornerRadius="12dp"
                android:visibility="gone" />

            <!-- Phase 3b/4: END ROUTE — finish trip entirely -->
            <com.google.android.material.button.MaterialButton
                android:id="@+id/btn_end_route"
                android:layout_width="match_parent"
                android:layout_height="52dp"
                android:layout_marginTop="8dp"
                android:text="🔚  END ROUTE"
                android:textSize="14sp"
                android:textStyle="bold"
                android:textColor="#FFFFFF"
                app:backgroundTint="#7F8C8D"
                app:cornerRadius="12dp"
                android:visibility="gone" />
        </LinearLayout>

        <!-- IDLE panel -->
        <LinearLayout
            android:id="@+id/idle_panel"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:background="#FFFFFF"
            android:elevation="6dp"
            android:gravity="center_vertical"
            android:paddingStart="16dp"
            android:paddingEnd="16dp"
            android:paddingTop="14dp"
            android:paddingBottom="14dp">

            <View android:layout_width="10dp" android:layout_height="10dp"
                android:layout_marginEnd="10dp"
                android:background="@drawable/dot_done" />

            <TextView
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="Online — sharing location, waiting for requests"
                android:textSize="13sp"
                android:textColor="#3B608C"
                android:textStyle="bold" />
        </LinearLayout>

    </LinearLayout>
</FrameLayout>