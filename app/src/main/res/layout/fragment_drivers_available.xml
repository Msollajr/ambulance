<?xml version="1.0" encoding="utf-8"?>
<!-- Uses hardcoded colors — safe on ALL themes including non-Material3 -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="#F7F8FA">

    <!-- Header -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:background="#FFFFFF"
        android:elevation="4dp"
        android:paddingStart="16dp"
        android:paddingEnd="16dp"
        android:paddingTop="14dp"
        android:paddingBottom="14dp">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="My Drivers"
            android:textSize="20sp"
            android:textStyle="bold"
            android:textColor="#1A1A2E" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="All drivers assigned to your organisation"
            android:textSize="12sp"
            android:textColor="#888888"
            android:layout_marginTop="2dp" />
    </LinearLayout>

    <!-- Empty state -->
    <TextView
        android:id="@+id/tv_no_drivers"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:gravity="center"
        android:text="No drivers found for your organisation"
        android:textSize="15sp"
        android:textColor="#888888"
        android:visibility="gone" />

    <!-- Driver list -->
    <androidx.recyclerview.widget.RecyclerView
        android:id="@+id/rv_drivers"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:paddingTop="8dp"
        android:paddingBottom="16dp"
        android:clipToPadding="false" />

</LinearLayout>