<?xml version="1.0" encoding="utf-8"?>
<androidx.cardview.widget.CardView
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginStart="12dp"
    android:layout_marginEnd="12dp"
    android:layout_marginTop="6dp"
    android:layout_marginBottom="6dp"
    app:cardCornerRadius="14dp"
    app:cardElevation="3dp"
    app:cardBackgroundColor="#FFFFFF">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="14dp">

        <!-- Top row: plate + type badge + status badge -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:layout_marginBottom="10dp">

            <LinearLayout
                android:layout_width="44dp"
                android:layout_height="44dp"
                android:background="@drawable/driver_avatar_bg"
                android:gravity="center">
                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="🚑"
                    android:textSize="20sp" />
            </LinearLayout>

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:layout_marginStart="10dp"
                android:orientation="vertical">

                <TextView
                    android:id="@+id/tv_amb_plate"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="T 123 ABC"
                    android:textSize="17sp"
                    android:textStyle="bold"
                    android:textColor="#1A1A2E" />

                <LinearLayout
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:layout_marginTop="4dp">

                    <TextView
                        android:id="@+id/tv_amb_type"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="BLS"
                        android:textSize="11sp"
                        android:textStyle="bold"
                        android:textColor="#FFFFFF"
                        android:background="@drawable/badge_navy"
                        android:paddingStart="8dp"
                        android:paddingEnd="8dp"
                        android:paddingTop="3dp"
                        android:paddingBottom="3dp" />

                    <TextView
                        android:id="@+id/tv_amb_equip"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="FULL"
                        android:textSize="11sp"
                        android:textStyle="bold"
                        android:textColor="#3B608C"
                        android:background="@drawable/badge_ambulance_maybe"
                        android:paddingStart="8dp"
                        android:paddingEnd="8dp"
                        android:paddingTop="3dp"
                        android:paddingBottom="3dp"
                        android:layout_marginStart="6dp" />
                </LinearLayout>
            </LinearLayout>

            <TextView
                android:id="@+id/tv_amb_status"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="AVAILABLE"
                android:textSize="10sp"
                android:textStyle="bold"
                android:textColor="#FFFFFF"
                android:paddingStart="10dp"
                android:paddingEnd="10dp"
                android:paddingTop="4dp"
                android:paddingBottom="4dp"
                android:background="@drawable/badge_low" />
        </LinearLayout>

        <!-- Info row: cost + driver -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:background="#F7F8FA"
            android:padding="10dp"
            android:layout_marginBottom="10dp">

            <LinearLayout android:layout_width="0dp" android:layout_height="wrap_content"
                android:layout_weight="1" android:orientation="vertical">
                <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
                    android:text="COST / TRIP" android:textSize="10sp" android:textColor="#888888"
                    android:textStyle="bold" />
                <TextView android:id="@+id/tv_amb_cost"
                    android:layout_width="wrap_content" android:layout_height="wrap_content"
                    android:text="TZS 50,000" android:textSize="13sp" android:textStyle="bold"
                    android:textColor="#1A1A2E" android:layout_marginTop="2dp" />
            </LinearLayout>

            <View android:layout_width="1dp" android:layout_height="match_parent"
                android:background="#DDDDDD" />

            <LinearLayout android:layout_width="0dp" android:layout_height="wrap_content"
                android:layout_weight="2" android:orientation="vertical"
                android:layout_marginStart="10dp">
                <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
                    android:text="ASSIGNED DRIVER" android:textSize="10sp" android:textColor="#888888"
                    android:textStyle="bold" />
                <TextView android:id="@+id/tv_amb_driver"
                    android:layout_width="wrap_content" android:layout_height="wrap_content"
                    android:text="No driver assigned" android:textSize="13sp"
                    android:textColor="#AAAAAA" android:layout_marginTop="2dp" />
            </LinearLayout>
        </LinearLayout>

        <!-- Action buttons -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal">

            <TextView
                android:id="@+id/btn_edit_amb"
                android:layout_width="0dp"
                android:layout_height="38dp"
                android:layout_weight="1"
                android:layout_marginEnd="6dp"
                android:gravity="center"
                android:text="Edit"
                android:textSize="13sp"
                android:textStyle="bold"
                android:textColor="#3B608C"
                android:background="@drawable/type_card_unselected"
                android:clickable="true"
                android:focusable="true" />

            <TextView
                android:id="@+id/btn_assign_driver"
                android:layout_width="0dp"
                android:layout_height="38dp"
                android:layout_weight="2"
                android:layout_marginStart="6dp"
                android:gravity="center"
                android:text="Assign Driver"
                android:textSize="13sp"
                android:textStyle="bold"
                android:textColor="#FFFFFF"
                android:background="@drawable/badge_navy"
                android:clickable="true"
                android:focusable="true" />
        </LinearLayout>

    </LinearLayout>

</androidx.cardview.widget.CardView>
